{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    // rootDir spans the repo root so the sidecar can pull in the shared
    // grooming prompt blocks from src/lib/. The runtime path is the
    // esbuild bundle (dist/bundle.cjs); tsc dist layout is incidental.
    "rootDir": "..",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": false,
    "sourceMap": false
  },
  "include": ["src/**/*", "../src/lib/groomingPromptBlocks.ts"],
  "exclude": ["node_modules", "dist"]
}
